= turbo_frame_tag 'widgets', data: {turbo: false} do
  - ont_uri = "/ontologies/#{@ontology.acronym}"
  - get_code_prefix = ont_uri + '?p=widgets#TB_inline&height=400&width=600'
  - first_class_id = @ontology.explore.classes["collection"]&.first&.id || ""

  - if @ontology.metadata_only?
    #widgets_content{:style => "padding: 1em;"}
      %p
        Widgets are only available for ontologies stored in #{$SITE}.
  - else
    #widgets_content
      %link{:rel => "stylesheet", :type => "text/css", :href => "/widgets/modern/ontoportal-widgets.css"}
      %script{:src => "/widgets/modern/ontoportal-widgets.js"}

      .d-flex.justify-content-between.align-items-center.pb-3.mb-4.border-bottom
        %div
          %h4.mb-1 Web Widgets for #{@ontology.acronym}
          %p.text-muted.mb-0 Embed modern, accessible, zero-dependency Custom Elements or legacy NCBO widgets into your application.
        %div
          %a.btn.btn-outline-primary.btn-sm{:href => "/widgets/modern/demo.html", :target => "_blank"}
            Full Interactive Demo &nearr;

      -# Modern Web Components Showcase
      .mb-5
        %h5.mb-3
          %span.badge.bg-success Modern Web Components
          %small.text-muted.ms-2 Native Custom Elements with Shadow DOM and WCAG 2.2 accessibility

        .row.g-4
          -# 1. Autocomplete
          .col-md-6
            .card.h-100.shadow-sm
              .card-header.bg-light
                %strong 1. Form Autocomplete (&lt;ontoportal-autocomplete&gt;)
              .card-body
                %p.small.text-muted Search and select concepts with keyboard navigation and automatic hidden input synchronization.
                .mb-3
                  %ontoportal-autocomplete{:name => "selected_concept", "api-url" => "#{$REST_URL}", "api-key" => "#{$API_KEY}", :ontologies => "#{@ontology.acronym}", :placeholder => "Search #{@ontology.acronym} classes..."}
                %details.mt-2
                  %summary.small.text-primary.cursor-pointer Get Embed Code
                  %pre.bg-dark.text-light.p-2.rounded.small.mt-2
                    = preserve do
                      :escaped
                        <!-- Include once in <head> -->
                        <link rel="stylesheet" href="#{$UI_URL}/widgets/modern/ontoportal-widgets.css">
                        <script src="#{$UI_URL}/widgets/modern/ontoportal-widgets.js"></script>

                        <!-- Place anywhere in your <form> -->
                        <ontoportal-autocomplete
                          name="concept_uri"
                          api-url="#{$REST_URL}"
                          api-key="YOUR_API_KEY"
                          ontologies="#{@ontology.acronym}"
                          placeholder="Search #{@ontology.acronym}..."
                          value-field="uri">
                        </ontoportal-autocomplete>

          -# 2. Concept Card
          .col-md-6
            .card.h-100.shadow-sm
              .card-header.bg-light
                %strong 2. Concept Detail Card (&lt;ontoportal-concept-card&gt;)
              .card-body
                %p.small.text-muted Display preferred labels, CURIEs, definitions, and synonyms with 1-click clipboard copy.
                .mb-3
                  - if first_class_id.present?
                    %ontoportal-concept-card{"api-url" => "#{$REST_URL}", "api-key" => "#{$API_KEY}", :ontology => "#{@ontology.acronym}", "concept-id" => first_class_id}
                  - else
                    %p.small.text-muted No sample class available for preview.
                %details.mt-2
                  %summary.small.text-primary.cursor-pointer Get Embed Code
                  %pre.bg-dark.text-light.p-2.rounded.small.mt-2
                    = preserve do
                      :escaped
                        <ontoportal-concept-card
                          api-url="#{$REST_URL}"
                          api-key="YOUR_API_KEY"
                          ontology="#{@ontology.acronym}"
                          concept-id="#{first_class_id.presence || 'CLASS_URI'}">
                        </ontoportal-concept-card>

        - unless @ontology.flat?
          -# 3. Hierarchy Tree
          .row.g-4.mt-1
            .col-12
              .card.shadow-sm
                .card-header.bg-light
                  %strong 3. Hierarchy Tree (&lt;ontoportal-tree&gt;)
                .card-body
                  %p.small.text-muted Expandable class tree with lazy node loading, embedded search filter, and full keyboard navigation.
                  .row
                    .col-md-7
                      %ontoportal-tree#widgets-tree-preview{"api-url" => "#{$REST_URL}", "api-key" => "#{$API_KEY}", :ontology => "#{@ontology.acronym}", :searchable => "true"}
                    .col-md-5
                      %ontoportal-concept-card#widgets-tree-card{"api-url" => "#{$REST_URL}", "api-key" => "#{$API_KEY}", :ontology => "#{@ontology.acronym}"}
                      :javascript
                        document.addEventListener('DOMContentLoaded', function() {
                          var tree = document.getElementById('widgets-tree-preview');
                          var card = document.getElementById('widgets-tree-card');
                          if (tree && card) {
                            tree.addEventListener('ontoportal:node-selected', function(e) {
                              card.setAttribute('concept-id', e.detail.nodeId);
                            });
                          }
                        });
                  %details.mt-3
                    %summary.small.text-primary.cursor-pointer Get Embed Code
                    %pre.bg-dark.text-light.p-2.rounded.small.mt-2
                      = preserve do
                        :escaped
                          <ontoportal-tree
                            api-url="#{$REST_URL}"
                            api-key="YOUR_API_KEY"
                            ontology="#{@ontology.acronym}"
                            searchable="true">
                          </ontoportal-tree>

      -# Legacy Widgets Section
      .mt-5.pt-4.border-top
        %h5.text-muted.mb-3
          %span.badge.bg-secondary Legacy NCBO Widgets
          %small.ms-2 Preserved for existing integrations (jQuery / IFrame)

        %table#widget_table{width: "100%"}
          %tr
            %th{style: "width: 35%;"} Widget type
            %th Widget demonstration
          %tr
            %td
              %div.card
                %div.card-body
                  %h5.card-title Jump To
                  %p.card-text Type a class name from #{@ontology.acronym} and jump to it in #{$SITE}
                  %a.btn.btn-outline-info.btn-sm.thickbox{href: "#{get_code_prefix}&inlineId=jump".html_safe} Get code
            %td
              #bp_quick_jump
              :javascript
                var BP_SEARCH_SERVER = "#{$UI_URL}";
                var BP_SITE = "#{$SITE}";
                var BP_ORG = "#{$ORG}";
                var BP_ontology_id = "#{@ontology.acronym}";
              = javascript_include_tag "/javascripts/widgets/quick_jump.js"
              #jump{:style => "display:none;"}
                %h2 Step 2: Follow the Instructions
                %hr/
                .enable-lists
                  %ul
                    %li
                      Download the
                      %a.external.free{:href => "/javascripts/widgets/quick_jump.js", :rel => "nofollow", :title => "/javascripts/widgets/quick_jump.js"}
                        %b quick_jump.js file
                      and put it on your server
                    %li
                      Copy the code below and paste it to your HTML page
                    %li
                      %b Note:
                      If you would like to use Quick Jump across multiple ontologies:
                      %ul
                        %li
                          You can enter a comma-separated list of ontology ids:
                          %br/
                          var BP_ontology_id = "NCIt,SNOMEDCT";
                        %li
                          You can set the variable to 'all' to search all ontologies in #{$SITE}:
                          %br/
                          var BP_ontology_id = "all";
                    %li
                      To include definitions in the Jump To drop-down, add the following variable in Javascript:
                      %br/
                      %pre var BP_include_definitions = true;
          %tr
            %td
              %div.card
                %div.card-body
                  %h5.card-title Form Autocomplete (Legacy)
                  %p.card-text Fill your form fields using the legacy jQuery autocomplete plugin
                  %a.btn.btn-outline-info.btn-sm.thickbox{href: "#{get_code_prefix}&inlineId=form".html_safe} Get code
            %td
              = javascript_include_tag "/javascripts/widgets/form_complete.js"
              Example 1 (start typing the class name to get its full URI)
              %br/
              %input{:class => "bp_form_complete-#{CGI.escape(@ontology.acronym).sub('-', '%2d')}-uri", :name => "a", :size => "80", :type => "text"}/
              #form{:style => "display:none;"}
                .enable-lists
                  %h2 Step 2: Follow the Instructions
                  %hr/
                  %ul
                    %li
                      Download the
                      %a.external.free{:href => "/javascripts/widgets/form_complete.js", :rel => "nofollow", :title => "/javascripts/widgets/form_complete.js"}
                        %b form_complete.js file
                      and put it on your server.
                    %li
                      On your form, specify the field's class:
                      %code bp_form_complete-#{@ontology.acronym}-uri

          %tr
            %td
              %div.card
                %div.card-body
                  %h5.card-title Visualization
                  %p.card-text Display an interactive iframe visualization for #{@ontology.acronym}
                  %a.btn.btn-outline-info.btn-sm.thickbox{href: "#{get_code_prefix}&inlineId=vis".html_safe} Get code
            %td
              - if first_class_id.present?
                #bp_vis_container
                  <iframe frameborder="0" src="/widgets/visualization?ontology=#{@ontology.acronym}&class=#{CGI.escape(first_class_id)}&apikey=#{$APIKEY}" width="100%" height="250"></iframe>
              - else
                %p.text-muted No class available for visualization preview.
              #vis{:style => "display:none;"}
                %h2 Step 2: Follow the Instructions
                %hr/
                %pre
                  = preserve do
                    :escaped
                      <iframe frameborder="0" src="/widgets/visualization?ontology=#{@ontology.acronym}&class=#{CGI.escape(first_class_id)}&apikey=YOUR_API_KEY"></iframe>

          - unless @ontology.flat?
            %tr
              %td
                %div.card
                  %div.card-body
                    %h5.card-title Tree Widget (Legacy / Shim)
                    %p.card-text jQuery NCBO Tree widget (supported natively or via shim)
                    %a.btn.btn-outline-info.btn-sm.thickbox{href: "#{get_code_prefix}&inlineId=widget_tree_popup".html_safe} Get code
              %td
                #bp_widget_tree_container
                <link rel="stylesheet" type="text/css" href="/widgets/jquery.ncbo.tree.css">
                <div id="widget_tree"></div>
                :javascript
                  $.getScript("/widgets/jquery.ncbo.tree.shim.js", function() {
                    $("#widget_tree").NCBOTree({
                      apikey: "#{$API_KEY}",
                      ontology: "#{@ontology.acronym}",
                      ncboUIURL: "#{$UI_URL}",
                      ncboAPIURL: "#{$REST_URL}"
                    });
                  });

                #widget_tree_popup{:style => "display:none;"}
                  %h2 Step 2: Follow the Instructions
                  %hr/
                  %pre
                    = preserve do
                      :escaped
                        <script src="/widgets/jquery.ncbo.tree.shim.js"></script>
                        <div id="widget_tree"></div>
                        <script>
                          $("#widget_tree").NCBOTree({
                            apikey: "YOUR_API_KEY",
                            ontology: "#{@ontology.acronym}"
                          });
                        </script>
