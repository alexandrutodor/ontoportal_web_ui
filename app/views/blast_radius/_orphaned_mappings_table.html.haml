- mappings = Array(@report&.orphaned_mappings)

.section-card
  .card-header
    %span
      %i.fas.fa-unlink.me-2
      Orphaned External Mappings
    %span.badge{class: mappings.empty? ? 'bg-success' : 'bg-danger'}
      #{mappings.size} Orphaned
  .card-body.p-0
    - if mappings.empty?
      .p-3.text-muted.text-center
        %i.fas.fa-check-circle.text-success.me-2
        No external mappings orphaned by this candidate ontology release.
    - else
      %table.table.table-hover.table-striped
        %thead
          %tr
            %th Mapping ID
            %th Source Concept
            %th Predicate
            %th Target Concept
            %th Failure Impact
        %tbody
          - mappings.each do |m|
            - m_hash = m.is_a?(Hash) ? m : (m.respond_to?(:to_h) ? m.to_h : {})
            %tr
              %td
                %code= m_hash[:mapping_id] || m_hash['mapping_id'] || '-'
              %td
                %code= m_hash[:from_concept] || m_hash['from_concept'] || '-'
              %td
                %span.badge.bg-light.text-dark= m_hash[:relation] || m_hash['relation'] || 'skos:exactMatch'
              %td
                %code= m_hash[:to_concept] || m_hash['to_concept'] || '-'
              %td.text-danger
                = m_hash[:reason] || m_hash['reason'] || 'Referenced concept missing in candidate'
