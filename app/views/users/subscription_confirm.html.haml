- is_subscribe = @action_type.to_s == 'subscribe'
- @title = is_subscribe ? t('users.subscribe_confirm_title') : t('users.unsubscribe_confirm_title')
.d-flex.justify-content-center.m-4
  .lost-password-form
    .d-flex.justify-content-between
      .lost-password-title-container
        %h2.lost-password-title
          = @title
        %hr#lost-password-title-line/
    %p.lost-password-description
      - if is_subscribe
        = t('users.subscribe_confirm_prompt', user: (@user&.username || @target_username), list: ($ANNOUNCE_LIST || 'announcements'))
      - else
        = t('users.unsubscribe_confirm_prompt', email: (@email || @target_email), list: ($ANNOUNCE_LIST || 'announcements'))
    - target_url = is_subscribe ? subscribe_user_path(@user&.username || @target_username) : unsubscribe_user_path(@email || @target_email)
    = form_with(url: target_url, method: :post, data: { turbo: false }) do |f|
      - if is_subscribe
        = f.hidden_field :username, value: (@user&.username || @target_username)
      - else
        = f.hidden_field :email, value: (@email || @target_email)
      .d-flex.justify-content-between.align-items-center.mt-4
        = f.submit (is_subscribe ? t('users.subscribe_confirm_button') : t('users.unsubscribe_confirm_button')), class: "lost-password-button"
        = link_to t('users.cancel'), "/account", class: "btn btn-outline-secondary"
