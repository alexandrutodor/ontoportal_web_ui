- @title = 'Datasets'
.container.my-4.datasets-page
  .d-flex.justify-content-between.align-items-center.mb-3
    %h1.mb-0 Datasets
  = form_with url: datasets_path, method: :get, local: true, class: 'mb-4' do |form|
    .input-group
      = form.search_field :q, value: @query, class: 'form-control', placeholder: 'Search datasets', aria: { label: 'Search datasets' }
      .input-group-append
        = form.submit 'Search', class: 'btn btn-primary'
  - if @datasets_error
    .alert.alert-warning{role: 'alert'}= @datasets_error
  - elsif @datasets.empty?
    .alert.alert-info No datasets are available.
  - else
    .row
      - @datasets.each do |dataset|
        .col-md-6.mb-3
          .card.h-100
            .card-body
              %h2.h5.card-title= link_to dataset.title, dataset_path(dataset.id)
              - if dataset.description.present?
                %p.card-text= dataset.description
              - if dataset.publisher.present?
                %p.card-text.text-muted.mb-0
                  %small= "Publisher: #{dataset.publisher}"

  .browse-mode-row.mt-4
    .browse-switch{role: 'navigation', aria: {label: 'Browse resource type'}}
      = link_to ontologies_path, class: 'browse-switch-link' do
        %i.fas.fa-sitemap
        Ontologies
      = link_to datasets_path, class: 'browse-switch-link active', aria: {current: 'page'} do
        %i.fas.fa-database
        Datasets
      - if Flipper.enabled?(:models_catalogue)
        = link_to models_path, class: 'browse-switch-link' do
          %i.fas.fa-cubes
          Models
      - if Flipper.enabled?(:workflows_catalogue)
        = link_to workflows_path, class: 'browse-switch-link' do
          %i.fas.fa-project-diagram
          Workflows
      - if Flipper.enabled?(:repositories_catalogue)
        = link_to repositories_path, class: 'browse-switch-link' do
          %i.fas.fa-code-branch
          Repositories
