- @title = t('login.logout_confirm_title')
.d-flex.justify-content-center.m-4
  .lost-password-form
    .d-flex.justify-content-between
      .lost-password-title-container
        %h2.lost-password-title
          = t('login.logout_confirm_title')
        %hr#lost-password-title-line/
    %p.lost-password-description
      - if session[:admin_user]
        = t('login.admin_return_confirm', old_user: session[:user]&.username, user: session[:admin_user]&.username)
      - else
        = t('login.logout_confirm_prompt', user: session[:user]&.username)
    .d-flex.justify-content-between.align-items-center.mt-4
      = button_to t('login.logout_button'), logout_path, method: :delete, class: "lost-password-button", form: { data: { turbo_frame: '_top' } }
      = link_to t('login.cancel'), (request.referer || "/"), class: "btn btn-outline-secondary"
