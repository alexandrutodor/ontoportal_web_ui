- @title = t('login.reset_password_title')
.d-flex.justify-content-center.m-4
  .lost-password-form
    .d-flex.justify-content-between
      .lost-password-title-container
        %h2.lost-password-title
          = t('login.reset_password_title')
        %hr#lost-password-title-line/
    %p.lost-password-description
      = t('login.reset_password_prompt', username: @username)
    = form_with(url: reset_password_path, method: :post, data: { turbo: false }) do |f|
      = f.hidden_field :un, value: @username
      = f.hidden_field :em, value: @email
      = f.hidden_field :tk, value: @token
      .d-flex.justify-content-between.align-items-center.mt-4
        = f.submit t('login.confirm_reset_password'), class: "lost-password-button"
        = link_to t('login.cancel'), "/login", class: "btn btn-outline-secondary"
