%div.clipboard.d-flex.align-items-center{data: {controller: 'clipboard', 'clipboard-copied-message-value': copied_label, 'clipboard-failed-message-value': failed_label}, style: 'cursor:pointer;'}
  %div{data: {'clipboard-target': 'content'}, class: @show_content ? '' : 'd-none'}= @message || content
  %button.clipboard-btn.btn.p-0.border-0.bg-transparent.d-inline-flex.align-items-center{type: 'button', aria: {label: accessible_label}, data: {action: 'click->clipboard#copy', 'clipboard-target': 'button'}}
    %span.copy{data: {controller: 'tooltip', 'clipboard-target': 'copy'}, title: @title}
      = inline_svg_tag(@icon, width: '20', height: '21px', fill: 'none')
    %span.d-none.check{data: {controller: 'tooltip', 'clipboard-target': 'check'}, title: copied_label}
      = inline_svg_tag('check.svg', width: '18px', height: '18px')
    %span.d-none.fail{data: {controller: 'tooltip', 'clipboard-target': 'fail'}, title: failed_label}
      = inline_svg_tag('icons/error.svg', width: '18px', height: '18px')
  %span.sr-only{data: {'clipboard-target': 'feedback'}, aria: {live: 'polite'}}
