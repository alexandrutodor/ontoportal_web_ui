.notification{class: notification_class, data: { controller: 'notification', 'notification-auto-remove-value': auto_remove?.to_s }}
  .notification-inner
    .notification-content
      %span
        = notification_type_icon
      .notification-text
        %p.text-sm.font-medium.text-gray-900
          = @title
        %p
          = @comment
      .ml-4.flex-shrink-0.d-flex
        %button.notification-close{type: 'button', data: { action: 'notification#dismiss' }}
          = svg_icon('close')