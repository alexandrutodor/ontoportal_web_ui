.dropdown-container
  %button.dropdown-title-bar.border-0.bg-transparent.text-left.w-100{type: "button", "data-toggle" => "collapse", "data-target" => "##{@id}", "aria-expanded" => (@is_open ? "true" : "false"), "aria-controls" => @id}
    - if title?
      = title
    - else
      = render Display::HeaderComponent.new(text: @title, tooltip: @tooltip)
    = image_tag("summary/arrow-down.svg", class: 'ml-2')

  .collapse{id: @id, class: open_class}
    - if content && !content.empty?
      = content
    - else
      = render Layout::ListComponent.new do |l|
        - l.row do  
          = empty_state || 'no data'
